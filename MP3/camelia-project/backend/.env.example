# Copy to backend/.env (never commit .env) or set these in Render.
# Local default: SQLite file backend/camelia.db
DATABASE_URL=sqlite:///./camelia.db
# Production (Neon): postgresql://user:password@host/dbname?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# "*" allows every origin (development). In production list your Vercel URL.
CORS_ORIGINS=*

# Load the demo menu automatically when the database is empty.
AUTO_SEED=1

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1️⃣ BACKEND (port 9000)",
      "detail": "Terminal 1 — API. Installs deps, seeds the database, runs uvicorn.",
      "type": "shell",
      "command": "./run.sh",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "2️⃣ FRONTEND (port 5173)",
      "detail": "Terminal 2 — React app. Installs node modules, runs vite.",
      "type": "shell",
      "command": "./run.sh",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "3️⃣ RUN BOTH (one terminal)",
      "detail": "Convenience only — starts the two servers together in a single panel.",
      "type": "shell",
      "command": "./start.sh",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "4️⃣ Reset demo database",
      "type": "shell",
      "command": "./.venv/bin/python seed.py --reset",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "5️⃣ Run backend tests",
      "type": "shell",
      "command": "./.venv/bin/python -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "6️⃣ Build frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/MP3/camelia-project/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "7️⃣ Git pull (arena branch)",
      "type": "shell",
      "command": "git checkout arena/cb16c143-camelia-ai-menu && git pull origin arena/cb16c143-camelia-ai-menu",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

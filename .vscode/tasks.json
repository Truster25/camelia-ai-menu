{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Camelia: start everything",
      "detail": "Installs what is missing, seeds the database, then runs API (9000) + website (5173). Ctrl-C stops both.",
      "type": "shell",
      "command": "./start.sh",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Camelia: start backend only (9000)",
      "type": "shell",
      "command": "./.venv/bin/python -m uvicorn app.main:app --reload --reload-dir app --port 9000",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Camelia: start frontend only (5173)",
      "type": "shell",
      "command": "npm run dev -- --port 5173",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project/frontend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Camelia: reset database (fresh 26 dishes)",
      "type": "shell",
      "command": "./start.sh --reset",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Camelia: run backend tests",
      "type": "shell",
      "command": "./.venv/bin/python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Camelia: build frontend (type check)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/MP3/camelia-project/frontend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Camelia: pull latest from my branch",
      "type": "shell",
      "command": "git checkout arena/cb16c143-camelia-ai-menu && git pull origin arena/cb16c143-camelia-ai-menu",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
